# This file lives at the PROJECT ROOT (same level as docker-compose.yml).
# Docker Compose reads it automatically to fill in the build args for the
# frontend image. Copy this to ".env" (same folder) and fill in real values.
#
# These are the SAME values as in frontend/.env.local.example - yes, you
# need them in both places. frontend/.env.local is for "npm run dev"
# without Docker. This root .env is for "docker compose up --build".

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
